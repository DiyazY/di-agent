# Example configuration for poc2 deployment scripts.
# Copy this file to .env and adjust values for your local environment.
# Existing exported variables in the shell take priority over these defaults.

# Shared SSH settings
SSH_USER=ubuntu
SSH_KEY="$HOME/.ssh/id_ed25519_vms"

# Kafka
KAFKA_IMAGE=apache/kafka
KAFKA_IMAGE_TAG=latest
KAFKA_PORT=9092
KAFKA_NAMESPACE=default
# Use a valid KRaft cluster UUID for local or shared deployments.
KAFKA_CLUSTER_ID=REPLACE_WITH_KAFKA_CLUSTER_ID

# Shared telemetry settings
KAFKA_TOPIC=genset.telemetry

# Genset
GENSET_IMAGE_NAME=genset
GENSET_IMAGE_TAG=latest

# Propulsion
PROPULSION_IMAGE_NAME=propulsion
PROPULSION_IMAGE_TAG=latest
PROPULSION_KAFKA_TOPIC=propulsion.telemetry

# InfluxDB
INFLUXDB_IMAGE=influxdb
INFLUXDB_IMAGE_TAG=2.7
INFLUXDB_PORT=8086
INFLUXDB_NAMESPACE=default
INFLUXDB_ORG=di-agent
INFLUXDB_BUCKET=genset-telemetry
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me
# Use a secure token for anything beyond a small test deployment.
INFLUXDB_ADMIN_TOKEN=replace-with-secure-token

# Telemetry writer
TELEMETRY_WRITER_IMAGE_NAME=telemetry-writer
TELEMETRY_WRITER_IMAGE_TAG=latest
KAFKA_GROUP_ID=telemetry-writer

# Grafana
GRAFANA_IMAGE=grafana/grafana
GRAFANA_IMAGE_TAG=latest
GRAFANA_PORT=3000
GRAFANA_NAMESPACE=default
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
