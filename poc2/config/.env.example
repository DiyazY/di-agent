# Example configuration for poc2 deployment scripts.
# Copy this file to .env and adjust values for your local environment.
# Existing exported variables in the shell take priority over these defaults.

# Shared SSH settings
SSH_USER=ubuntu
SSH_KEY="$HOME/.ssh/id_ed25519_vms"

# Kafka
KAFKA_IMAGE=apache/kafka
KAFKA_IMAGE_TAG=latest
KAFKA_PORT=9092
KAFKA_NAMESPACE=default
# Use a valid KRaft cluster UUID for local or shared deployments.
KAFKA_CLUSTER_ID=REPLACE_WITH_KAFKA_CLUSTER_ID

# Shared telemetry settings
GENSET_KAFKA_TOPIC=genset.telemetry

# Genset
GENSET_IMAGE_NAME=genset
GENSET_IMAGE_TAG=latest
# Number of genset instances to deploy (genset-1..genset-N); see 06-genset.sh.
GENSET_COUNT=4

# Propulsion
PROPULSION_IMAGE_NAME=propulsion
PROPULSION_IMAGE_TAG=latest
PROPULSION_KAFKA_TOPIC=propulsion.telemetry
# Number of propulsion instances to deploy (propulsion-1..propulsion-N); see
# 06b-propulsion.sh.
PROPULSION_COUNT=2

# Battery
BATTERY_IMAGE_NAME=battery
BATTERY_IMAGE_TAG=latest
BATTERY_KAFKA_TOPIC=battery.telemetry
# Number of battery instances to deploy (battery-1..battery-N); see
# 06c-battery.sh. The battery supplies power to the switchboard alongside
# the genset(s).
BATTERY_COUNT=1

# Auxiliary (hotel) load
AUXLOAD_IMAGE_NAME=auxload
AUXLOAD_IMAGE_TAG=latest
AUXLOAD_KAFKA_TOPIC=auxload.telemetry
# Number of auxiliary-load instances to deploy (auxload-1..auxload-N); see
# 06d-auxload.sh.
AUXLOAD_COUNT=1
# Initial load ratio (0.0-1.0) the auxiliary load starts at; adjustable at
# runtime via the same /load API as propulsion.
INITIAL_LOAD_RATIO=0.5

# InfluxDB
INFLUXDB_IMAGE=influxdb
INFLUXDB_IMAGE_TAG=2.7
INFLUXDB_PORT=8086
INFLUXDB_NAMESPACE=default
INFLUXDB_ORG=di-agent
INFLUXDB_BUCKET=telemetry
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me
# Use a secure token for anything beyond a small test deployment.
INFLUXDB_ADMIN_TOKEN=replace-with-secure-token

# Telemetry writer
TELEMETRY_WRITER_IMAGE_NAME=telemetry-writer
TELEMETRY_WRITER_IMAGE_TAG=latest
KAFKA_GROUP_ID=telemetry-writer

# Grafana
GRAFANA_IMAGE=grafana/grafana
GRAFANA_IMAGE_TAG=latest
GRAFANA_PORT=3000
GRAFANA_NAMESPACE=default
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Playground (React frontend for genset/propulsion)
PLAYGROUND_IMAGE_NAME=playground
PLAYGROUND_IMAGE_TAG=latest
PLAYGROUND_NODE_PORT=30080
