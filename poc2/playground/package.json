{
  "name": "di-agent-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cy:open": "cypress open",
    "cy:run": "cypress run --spec 'cypress/e2e/{playground,dataset}.cy.ts'",
    "cy:run:live": "cypress run --spec cypress/e2e/playground.live.cy.ts",
    "cy:run:live:dataset": "cypress run --spec cypress/e2e/dataset.live.cy.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cypress": "^16.3.0",
    "typescript": "^5.5.3",
    "vite": "^6.4.4"
  }
}
