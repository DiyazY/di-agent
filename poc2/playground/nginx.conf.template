server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # Runtime list of deployed genset/propulsion/battery/auxload instance
    # ids, fetched by the frontend on load so it can render one panel per
    # instance (see src/App.tsx). Generated by scripts/09-playground.sh from
    # GENSET_COUNT/PROPULSION_COUNT/BATTERY_COUNT/AUXLOAD_COUNT.
    location = /config.json {
        default_type application/json;
        return 200 '${CONFIG_JSON}';
    }

    # Proxied to each instance's own Service (see helm/di-agent-system).
    # so the browser never needs the pod/VM IPs directly. One location block
    # per instance is generated by scripts/09-playground.sh (see
    # GENSET_LOCATIONS/PROPULSION_LOCATIONS/BATTERY_LOCATIONS/AUXLOAD_LOCATIONS).
    ${GENSET_LOCATIONS}

    ${PROPULSION_LOCATIONS}

    ${BATTERY_LOCATIONS}

    ${AUXLOAD_LOCATIONS}

    location /api/switchboard/ {
        proxy_pass http://${SWITCHBOARD_UPSTREAM}/;
        proxy_set_header Host $host;
    }
}

