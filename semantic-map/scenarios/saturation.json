{
  "name": "saturation",
  "seed": 2,
  "tick_seconds": 10,
  "duration_seconds": 3600,
  "noise": 0.01,
  "node": {
    "node_cpu": {"coupling": "sum", "base": 0.10, "of": "cpu_utilization"},
    "pressure": {"coupling": "logistic", "theta": 0.85, "k": 0.05, "of": "node_cpu"}
  },
  "subjects": [
    {"id": "pod:a", "arrive": 0,
     "properties": {"cpu_utilization": {"pattern": "sine", "min": 0.30, "max": 0.90, "period": 600}}}
  ],
  "expect": {
    "admitted_within_ticks": 1,
    "candidates": [{"from": "cpu_utilization@pod:a", "to": "pressure", "sign": 1, "within_seconds": 1500}],
    "counterfactuals": [
      {"target": "pressure", "assume": {"cpu_utilization@pod:a": 0.90}, "regime": "saturated", "min_error": 0.10}
    ]
  }
}
